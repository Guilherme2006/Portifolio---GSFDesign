# Proteção básica de rotas — redireciona/nega acessos diretos via URL
# Ajuste o domínio abaixo se usar outro domínio/alias.
RewriteEngine On

# --- Forçar HTTPS ---
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# --- Impedir listagem de diretório ---
Options -Indexes

# --- Bloquear acesso a arquivos sensíveis ---
<FilesMatch "\.(env|git|htaccess|htpasswd)$">
    Require all denied
</FilesMatch>

# Bloquear acesso direto a arquivos .html e .php se o Referer não for do domínio
RewriteCond %{REQUEST_URI} \.(html|php)$ [NC]
RewriteCond %{HTTP_REFERER} !^https?://(www\.)?gsfdesign\.com\.br [NC]
RewriteRule .* / [R=302,L]

# Permitir assets estáticos (CSS, JS, imagens)
RewriteCond %{REQUEST_URI} \.(css|js|jpg|jpeg|png|gif|svg|ico|webp)$ [NC]
RewriteRule .* - [L]

# --- Security Headers ---
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Permissions-Policy "geolocation=(), microphone=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://cdnjs.cloudflare.com; style-src 'self' https://cdnjs.cloudflare.com 'unsafe-inline'; font-src https://cdnjs.cloudflare.com; img-src 'self' data: https:; connect-src 'self'; form-action 'self' https://formsubmit.co; frame-ancestors 'none';"
</IfModule>

# Observação: HSTS e CSP exigem HTTPS; ajuste o domínio em HSTS se necessário.
# ================================================
# SEGURANÇA MÁXIMA - PORTFOLIO GIOVANNI
# Configurado especificamente para LOCAWEB
# ================================================

# PROTEÇÃO 1: Forçar HTTPS (SSL)
# ================================================
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Redirecionar HTTP para HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
    
    # Remover www (descomente se preferir sem www)
    # RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    # RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
</IfModule>

# PROTEÇÃO 2: Headers de Segurança
# ================================================
<IfModule mod_headers.c>
    # HSTS - Força HTTPS por 1 ano
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    
    # Proteção XSS (Cross-Site Scripting)
    Header set X-XSS-Protection "1; mode=block"
    
    # Prevenir Clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"
    
    # Prevenir MIME type sniffing
    Header set X-Content-Type-Options "nosniff"
    
    # Content Security Policy (CSP)
    Header set Content-Security-Policy "default-src 'self' https:; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://fonts.googleapis.com; font-src 'self' https://cdnjs.cloudflare.com https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https:; frame-ancestors 'self';"
    
    # Política de Referrer
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Remover informações do servidor
    Header unset X-Powered-By
    Header always unset X-Powered-By
    
    # Permissões de recursos
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
</IfModule>

# PROTEÇÃO 3: Bloquear Acesso a Arquivos Sensíveis
# ================================================

# Proteger arquivos ocultos
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# Bloquear tipos de arquivo perigosos
<FilesMatch "\.(bak|conf|log|sql|zip|tar|gz|rar|env|git|htaccess|htpasswd|ini)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# PROTEÇÃO 4: Desabilitar Listagem de Diretórios
# ================================================
Options -Indexes

# PROTEÇÃO 5: Bloquear SQL Injection
# ================================================
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Bloquear tentativas de SQL injection
    RewriteCond %{QUERY_STRING} (union|select|insert|cast|set|declare|drop|update|delete) [NC]
    RewriteRule ^(.*)$ - [F,L]
    
    # Bloquear scripts maliciosos
    RewriteCond %{QUERY_STRING} (\<|%3C).*script.*(\>|%3E) [NC]
    RewriteRule ^(.*)$ - [F,L]
    
    # Bloquear tentativas de travessia de diretório
    RewriteCond %{QUERY_STRING} (\.\./|\.\.\\) [OR]
    RewriteCond %{REQUEST_URI} (\.|%2e)(\.|%2e)(/|%2f)
    RewriteRule ^(.*)$ - [F,L]
</IfModule>

# PROTEÇÃO 6: Proteção contra Hotlinking
# ================================================
# DESATIVADO - NÃO BLOQUEAR SUAS PRÓPRIAS IMAGENS!
# <IfModule mod_rewrite.c>
#     RewriteEngine On
#     RewriteCond %{HTTP_REFERER} !^$
#     RewriteCond %{HTTP_REFERER} !^https?://(www\.)?gsfdesign.com.br [NC]
#     RewriteRule \.(jpg|jpeg|png|gif|webp|svg)$ - [F,NC]
# </IfModule>

# PROTEÇÃO 7: Bloquear Bots Maliciosos
# ================================================
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP_USER_AGENT} (ahrefs|semrush|mj12bot|dotbot|HTTrack) [NC]
    RewriteRule .* - [F,L]
</IfModule>

# PROTEÇÃO 8: Compressão Gzip (Performance)
# ================================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# PROTEÇÃO 9: Cache de Arquivos
# ================================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType text/css "access plus 0 seconds"
    ExpiresByType application/javascript "access plus 0 seconds"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# PROTEÇÃO 10: Ocultar Versão do Servidor
# ================================================
ServerSignature Off

# FIM - Portfolio Giovanni - Locaweb
